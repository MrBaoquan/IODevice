    "/^powershell -Command \"\n# 导入 CSV\n\\\\\\$csvPath = 'o:\\\\DevModules\\\\IODevice\\\\IODevice\\\\IOStudio\\\\动感平台_实施计划_周期表\\.csv'\n\\\\\\$xlsxPath = 'o:\\\\DevModules\\\\IODevice\\\\IODevice\\\\IOStudio\\\\动感平台_实施计划_周期表\\.xlsx'\n\n# 读取 CSV \\(使用 GB2312 或 UTF-8 编码\\)\n\\\\\\$data = Import-Csv -Path \\\\\\$csvPath -Encoding UTF8\n\n# 创建 Excel 应用\n\\\\\\$excel = New-Object -ComObject Excel\\.Application\n\\\\\\$excel\\.Visible = \\\\\\$false\n\\\\\\$workbook = \\\\\\$excel\\.Workbooks\\.Add\\(\\)\n\\\\\\$worksheet = \\\\\\$workbook\\.ActiveSheet\n\n# 添加标题行\n\\\\\\$headers = @\\('阶段', 'Sprint', '周次', '起始日期', '结束日期', '工作日', '任务编号', '任务名称', '工时\\(h\\)', '优先级', '交付物', '备注'\\)\nfor \\(\\\\\\$i = 0; \\\\\\$i -lt \\\\\\$headers\\.Count; \\\\\\$i\\+\\+\\) \\{\n    \\\\\\$worksheet\\.Cells\\.Item\\(1, \\\\\\$i \\+ 1\\) = \\\\\\$headers\\[\\\\\\$i\\]\n\\}\n\n# 设置标题行格式 - 加粗、居中、蓝色背景\n\\\\\\$headerRange = \\\\\\$worksheet\\.Range\\('A1:L1'\\)\n\\\\\\$headerRange\\.Font\\.Bold = \\\\\\$true\n\\\\\\$headerRange\\.Font\\.Color = -16776961  # 白色\n\\\\\\$headerRange\\.Interior\\.Color = 12611584  # 蓝色\n\\\\\\$headerRange\\.HorizontalAlignment = -4108  # 居中\n\n# 添加数据行\n\\\\\\$row = 2\nforeach \\(\\\\\\$item in \\\\\\$data\\) \\{\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 1\\) = \\\\\\$item\\.阶段\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 2\\) = \\\\\\$item\\.Sprint\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 3\\) = \\\\\\$item\\.周次\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 4\\) = \\\\\\$item\\.起始日期\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 5\\) = \\\\\\$item\\.结束日期\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 6\\) = \\\\\\$item\\.工作日\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 7\\) = \\\\\\$item\\.任务编号\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 8\\) = \\\\\\$item\\.任务名称\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 9\\) = \\\\\\$item\\.'工时\\(h\\)'\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 10\\) = \\\\\\$item\\.优先级\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 11\\) = \\\\\\$item\\.交付物\n    \\\\\\$worksheet\\.Cells\\.Item\\(\\\\\\$row, 12\\) = \\\\\\$item\\.备注\n    \n    # 阶段变化时,改变背景色\n    if \\(\\\\\\$item\\.阶段 -ne '' -and \\\\\\$item\\.阶段 -like 'Phase\\*'\\) \\{\n        \\\\\\$phaseNum = \\[int\\]\\(\\\\\\$item\\.阶段 -replace '\\[\\^0-9\\]', ''\\)\n        if \\(\\\\\\$phaseNum % 2 -eq 0\\) \\{\n            \\\\\\$worksheet\\.Range\\(\\\\\"A\\\\\\$row:L\\\\\\$row\\\\\"\\)\\.Interior\\.Color = 14277081  # 浅灰\n        \\}\n    \\}\n    \n    \\\\\\$row\\+\\+\n\\}\n\n# 自动调整列宽\n\\\\\\$worksheet\\.Columns\\.AutoFit\\(\\) \\| Out-Null\n\n# 冻结标题行\n\\\\\\$worksheet\\.Application\\.ActiveWindow\\.SplitRow = 1\n\\\\\\$worksheet\\.Application\\.ActiveWindow\\.FreezePanes = \\\\\\$true\n\n# 保存\n\\\\\\$workbook\\.SaveAs\\(\\\\\\$xlsxPath, 51\\)  # 51 = xlOpenXMLWorkbook \\(\\.xlsx\\)\n\\\\\\$workbook\\.Close\\(\\)\n\\\\\\$excel\\.Quit\\(\\)\n\nWrite-Host \\\\\"Excel 文件已创建: \\\\\\$xlsxPath\\\\\"\n\"$/": {
