<IORoot>

	<Device Name="ExtDev" Type="External" DllName="modbus" Index="1">

		<Action Name="Start" Label="开始互动">
			<Key Name="Button_00" />
			<Key Name="S" />
		</Action>

		<Action Name="Fire" Label="开火">
			<Key Name="Button_01" />
			<Key Name="F" />
		</Action>

		<Axis Name="MoveX" Label="左右移动">
			<Key Name="Axis_00" Scale="10" />
			<Key Name="Right" Scale="10" />
			<Key Name="Left" Scale="-10" />
		</Axis>

		<Axis Name="MoveY" Label="前后移动">
			<Key Name="Axis_01" Scale="10" />
			<Key Name="Up" Scale="10" />
			<Key Name="Down" Scale="-10" />
		</Axis>

		<OAction Name="Light" Label="氛围灯">
			<Key Name="OAxis_00" Scale="10" InvertEvent="False" />
			<Key Name="OAxis_02" Scale="5" InvertEvent="False" />
		</OAction>

	</Device>
	<Device Name="ExtDev0" Type="External" DllName="ioui" Index="1" />

</IORoot>