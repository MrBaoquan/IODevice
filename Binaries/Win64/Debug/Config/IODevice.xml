<?xml version="1.0" encoding="utf-8"?>
<IORoot>
  <Device Name="YDL-0" Type="External" DllName="MP-YDL" Index="0">
    <!-- 速率上限是全局 Key 属性: 配一次, 所有引用该通道的 OAction/轨道都继承 -->
    <Properties>
      <Key Name="OAxis_6" SlewRate="0.5" />
    </Properties>
    <OAction Name="Heave" Label="电缸升降">
      <Key Name="OAxis_6" />
    </OAction>
    <OAction Name="Water" Label="喷水">
      <Key Name="OAxis_16" />
    </OAction>
    <OAction Name="Wind" Label="风扇">
      <Key Name="OAxis_18" />
    </OAction>
    <OAction Name="Hot" Label="热风">
      <Key Name="OAxis_20" />
    </OAction>
    <OAction Name="Vibrate" Label="震动">
      <Key Name="OAxis_22" />
    </OAction>
    <OAction Name="Scent" Label="香味">
      <Key Name="OAxis_24" />
    </OAction>
    <OAction Name="Shoot" Label="射击">
      <Key Name="OAxis_48" />
    </OAction>
    <OAction Name="Action" Label="动作">
      <Key Name="OAxis_49" />
    </OAction>
    <!-- 播控联动 (厂商私有区 DO[64..65]): 与插件 CH_GAME_READY / CH_GAME_OVER 对应。
         值变化到非 0 时发一条 GameState, 发送完该通道回读即复位 —— 是命令, 不是持续状态。 -->
    <OAction Name="GameReady" Label="游戏就绪(开始指令)">
      <Key Name="OAxis_64" />
    </OAction>
    <OAction Name="GameOver" Label="游戏结束">
      <Key Name="OAxis_65" />
    </OAction>
  </Device>
</IORoot>