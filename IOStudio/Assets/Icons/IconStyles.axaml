<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia">
    <!--
    ═══════════════════════════════════════════════════════════════
    图标语义化样式 (Icon Styles)
    ───────────────────────────────────────────────────────────────
    统一图标体系: 全部收敛到 IconPacks.Avalonia.Ionicons 矢量图标。
    用法: <iconPacks:PackIconIonicons Classes="icon-add16"/>
    禁止直接用 emoji / Unicode 字符 / PNG 位图作为交互图标。

    命名规范:
    icon-<语义><尺寸后缀>  如 icon-add16 / icon-delete16 / icon-play24

    尺寸约定 (遵循应用视觉规范):
    16 = 卡片/内联操作   24 = 工具栏/播放/全屏   32 = 空状态大图标
    ═══════════════════════════════════════════════════════════════
    -->

    <!-- ── 16px 通用操作 ── -->
    <Style Selector="iconPacks|PackIconIonicons.icon-add16">
        <Setter Property="Kind" Value="AddiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-close16">
        <Setter Property="Kind" Value="CloseiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-delete16">
        <Setter Property="Kind" Value="TrashiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-refresh16">
        <Setter Property="Kind" Value="RefreshiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-settings16">
        <Setter Property="Kind" Value="SettingsiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-save16">
        <Setter Property="Kind" Value="SaveiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-copy16">
        <Setter Property="Kind" Value="CopyiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-search16">
        <Setter Property="Kind" Value="SearchiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-document16">
        <Setter Property="Kind" Value="DocumentiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-info16">
        <Setter Property="Kind" Value="InformationCircleiOS"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
    </Style>

    <!-- ── 20px 状态/通道 ── -->
    <Style Selector="iconPacks|PackIconIonicons.icon-pulse20">
        <Setter Property="Kind" Value="PulseiOS"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-key20">
        <Setter Property="Kind" Value="KeyiOS"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
    </Style>

    <!-- ── 24px 工具栏/播放/全屏 ── -->
    <Style Selector="iconPacks|PackIconIonicons.icon-play24">
        <Setter Property="Kind" Value="PlayiOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-stop24">
        <Setter Property="Kind" Value="SquareiOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-fullscreen24">
        <Setter Property="Kind" Value="ResizeiOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-settings24">
        <Setter Property="Kind" Value="SettingsiOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-document24">
        <Setter Property="Kind" Value="DocumentiOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-radioon24">
        <Setter Property="Kind" Value="RadioButtonOniOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>
    <Style Selector="iconPacks|PackIconIonicons.icon-radiooff24">
        <Setter Property="Kind" Value="RadioButtonOffiOS"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Height" Value="24"/>
    </Style>

    <!-- ── 32px 大图标 (空状态) ── -->
    <Style Selector="iconPacks|PackIconIonicons.icon-grid32">
        <Setter Property="Kind" Value="GridiOS"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
    </Style>
</Styles>
