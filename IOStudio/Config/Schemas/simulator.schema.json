        {
          "key": "embedded_ui",
          "label": "启用内嵌 UI",
          "type": "boolean",
          "default": "0",
          "description": "本地内嵌界面占位开关，独立 Simulator UI 适配器接入前保持关闭"
        }
      ]
    },
