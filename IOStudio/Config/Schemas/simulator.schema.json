          "showInSummary": true,
          "summaryColor": "#059669"
        },
        {
          "key": "door_duration_ms",
          "label": "舱门行程时长 (ms)",
          "type": "number",
          "default": "3000",
          "description": "DO[35] 开门 / DO[36] 关门的行程时长",
          "min": 1
        },
        {
          "key": "lap_bar_duration_ms",
          "label": "压杠行程时长 (ms)",
          "type": "number",
          "default": "3000",
          "description": "DO[32] 安全带锁 / DO[33] 压杠下 / DO[34] 压杠上的行程时长",
          "min": 1
        },
        {
          "key": "carrier_duration_ms",
          "label": "载具行程时长 (ms)",
          "type": "number",
          "default": "3000",
          "description": "DO[44] 至展示位 / DO[45] 至停放位的行程时长",
          "min": 1
        },
        {
          "key": "effect_confirm_ms",
          "label": "特效确认延迟 (ms)",
          "type": "number",
          "default": "180",
          "description": "DI[16..22] 与 AD[32..38] 在收到 DO[16..22] 后延迟反映为实际状态",
          "min": 0
        }
      ]
    },
    {
      "name": "web",
      "title": "Web 调试页",
      "collapsed": true,
      "fields": [
        {
          "key": "web_enabled",
          "label": "启用 Web 调试页",
          "type": "boolean",
          "default": "1",
          "description": "插件自带本地 HTTP 服务，无鉴权，仅供开发期使用"
        },
        {
          "key": "web_port",
          "label": "Web 端口",
          "type": "number",
          "default": "18080",
          "description": "Windows 绑定 127.0.0.1，其他平台绑定 0.0.0.0",
