          "max": 65535,
          "showInSummary": true,
          "summaryColor": "#0891b2"
        },
        {
          "key": "web_auto_open",
          "label": "自动打开策略",
          "type": "text",
          "default": "resume",
          "description": "浏览器自动打开行为；resume 表示复用已打开的调试页"
