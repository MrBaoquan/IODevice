<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
			 xmlns:vm="using:IOStudio.ViewModels"
			 xmlns:converter="using:IOStudio.Converters"
			 xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
			 x:Class="IOStudio.Controls.IONodeView"
			 x:DataType="vm:IONodeBase">

	<Design.DataContext>
		<vm:OAction />
	</Design.DataContext>

	<UserControl.Styles>
		<!-- Key列表项的基础样式 -->
		<Style Selector="Border.key-item">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>

		<!-- 非active状态下的hover效果 - 通过优先级控制 -->
		<Style Selector="Border.key-item:pointerover">
			<Setter Property="Background" Value="{DynamicResource TlBtnHover}" />
		</Style>

		<Style Selector="Border.key-item.editing:pointerover">
			<Setter Property="Background" Value="{DynamicResource TlStatusOnlineBg}" />
		</Style>

		<Style Selector="Border.key-item.contextmenu:pointerover">
			<Setter Property="Background" Value="{DynamicResource TlAccentSoftBg}" />
		</Style>

		<!-- 节点标题行的基础样式 -->
		<Style Selector="Border.node-header">
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>

		<!-- 非active/recording状态下的hover效果 -->
		<Style Selector="Border.node-header:pointerover">
			<Setter Property="Background" Value="{DynamicResource TlBtnHover}" />
		</Style>

		<!-- 录制按钮样式 -->
		<Style Selector="Button.node-action-btn">
			<Setter Property="Opacity" Value="0.8" />
		</Style>
		<!-- 节点标题栏所有操作项使用同一尺寸、内边距和居中规则 -->
		<Style Selector="Button.node-tool-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
			<Setter Property="BorderThickness" Value="0" />
			<Setter Property="Padding" Value="0" />
			<Setter Property="Margin" Value="0 0 1 0" />
			<Setter Property="Width" Value="28" />
			<Setter Property="Height" Value="28" />
			<Setter Property="CornerRadius" Value="4" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="HorizontalContentAlignment" Value="Center" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15" />
				</Transitions>
			</Setter>
		</Style>
		<Style Selector="Button.node-tool-btn:pointerover">
			<Setter Property="Background" Value="{DynamicResource TlBtnHover}" />
			<Setter Property="Opacity" Value="1" />
		</Style>
		<!-- DO 切换按钮不显示 hover 背景（控件级 + Fluent 模板级），避免与激活状态产生歧义 -->
		<Style Selector="Button.node-do-btn:pointerover">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Opacity" Value="1" />
		</Style>
		<Style Selector="Button.node-do-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="BorderBrush" Value="Transparent" />
		</Style>
		<Style Selector="DockPanel.active Button.node-tool-btn">
			<Setter Property="Background" Value="Transparent" />
			<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}" />
		</Style>

		<!-- 录制呼吸动画 - 只用透明度实现 -->
		<Style Selector="Ellipse.recording-indicator">
			<Style.Animations>
				<Animation Duration="0:0:0.8" IterationCount="Infinite" PlaybackDirection="Alternate" Easing="SineEaseInOut">
					<KeyFrame Cue="0%">
						<Setter Property="Opacity" Value="1" />
					</KeyFrame>
					<KeyFrame Cue="100%">
						<Setter Property="Opacity" Value="0.4" />
					</KeyFrame>
				</Animation>
			</Style.Animations>
		</Style>

		<!-- 编辑按钮样式 -->
		<Style Selector="Button.node-edit-btn">
			<Setter Property="Foreground" Value="{DynamicResource TlAccent}" />
			<Setter Property="Opacity" Value="0.7" />
		</Style>
		<Style Selector="Button.node-edit-btn:pointerover">
			<Setter Property="Opacity" Value="1" />
			<Setter Property="Background" Value="{DynamicResource TlAccentSoftBg}" />
		</Style>
		<Style Selector="Border.node-header:not(.editing)">
			<Setter Property="Cursor" Value="Arrow" />
		</Style>
	</UserControl.Styles>

	<Border BorderThickness="1" CornerRadius="6" Background="{DynamicResource TlCardBg}" BorderBrush="{DynamicResource TlCardBorder}" Margin="6 4" MinWidth="180" MaxWidth="280">
		<StackPanel Orientation="Vertical" HorizontalAlignment="Stretch" Classes="active">
			<StackPanel.Styles>

				<Style Selector="DockPanel TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource TlTextPrimary}" />
				</Style>

				<!-- DockPanel默认透明背景，确保能响应hover -->
				<Style Selector="DockPanel">
					<Setter Property="Background" Value="Transparent" />
				</Style>

				<Style Selector="DockPanel.active">
					<Setter Property="Background" Value="{DynamicResource TlControlActiveBg}" />
				</Style>

				<!-- 确保active状态的DockPanel背景不被Border的hover覆盖 -->
				<Style Selector="Border.key-item:pointerover > DockPanel.active">
					<Setter Property="Background" Value="{DynamicResource TlControlActiveBg}" />
				</Style>

				<Style Selector="Border.node-header:pointerover > DockPanel.active">
					<Setter Property="Background" Value="{DynamicResource TlControlActiveBg}" />
				</Style>

				<!-- 确保recording状态的DockPanel背景不被Border的hover覆盖 -->
				<Style Selector="Border.node-header:pointerover > DockPanel.recording">
					<Setter Property="Background" Value="{DynamicResource TlStatusOfflineBg}" />
				</Style>

				<Style Selector="Border.editing">
					<Setter Property="Background" Value="{DynamicResource TlStatusOnlineBg}" />
					<Setter Property="BorderBrush" Value="{DynamicResource TlSuccess}" />
					<Setter Property="BorderThickness" Value="2" />
				</Style>

				<Style Selector="Border.contextmenu">
					<Setter Property="Background" Value="{DynamicResource TlAccentSoftBg}" />
					<Setter Property="BorderBrush" Value="{DynamicResource TlAccent}" />
					<Setter Property="BorderThickness" Value="2" />
				</Style>

				<Style Selector="DockPanel.recording">
					<Setter Property="Background" Value="{DynamicResource TlStatusOfflineBg}" />
				</Style>

				<Style Selector="DockPanel.recording TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource TlStatusOfflineFg}" />
				</Style>

				<Style Selector="DockPanel.recording iconPacks|PackIconIonicons">
					<Setter Property="Foreground" Value="{DynamicResource TlDanger}" />
				</Style>

				<Style Selector="DockPanel.active TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}" />
				</Style>

				<!-- 录制状态下的文字颜色优先级更高，覆盖active的白色 -->
				<Style Selector="DockPanel.active.recording TextBlock">
					<Setter Property="Foreground" Value="{DynamicResource TlStatusOfflineFg}" />
				</Style>

				<Style Selector="DockPanel.active iconPacks|PackIconIonicons">
					<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}" />
				</Style>

				<!-- 录制状态下的图标颜色 -->
				<Style Selector="DockPanel.active.recording iconPacks|PackIconIonicons">
					<Setter Property="Foreground" Value="{DynamicResource TlDanger}" />
				</Style>

				<Style Selector="ToggleButton iconPacks|PackIconIonicons.icon-on">
					<Setter Property="IsVisible" Value="False"/>
				</Style>

				<Style Selector="ToggleButton iconPacks|PackIconIonicons.icon-off">
					<Setter Property="IsVisible" Value="True"/>
				</Style>

				<Style Selector="Button">
					<Setter Property="Background" Value="Transparent"/>
				</Style>

				<Style Selector="DockPanel.active Button">
					<Setter Property="Background" Value="{DynamicResource TlControlActiveBg}"/>
				</Style>

				<Style Selector="DockPanel.active Button.node-tool-btn">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}"/>
				</Style>

				<Style Selector="DockPanel.active Button.node-tool-btn:pointerover">
					<Setter Property="Background" Value="{DynamicResource TlBtnHover}"/>
					<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}"/>
				</Style>
				<Style Selector="DockPanel.active Button.node-do-btn:pointerover">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}"/>
				</Style>
				<Style Selector="DockPanel.active Button.node-do-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
					<Setter Property="Background" Value="Transparent"/>
					<Setter Property="BorderBrush" Value="Transparent"/>
					<Setter Property="Foreground" Value="{DynamicResource TlControlActiveFg}"/>
				</Style>

			</StackPanel.Styles>

			<!-- 节点名称 -->
				<Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource TlCardBorder}" Classes="node-header" Classes.editing="{Binding IsEditMode}"
					DoubleTapped="OnNodeHeaderDoubleTapped">
				<DockPanel Classes.active="{Binding Active}" Classes.recording="{Binding IsRecording}" LastChildFill="True">
					<!-- 右侧按钮区域（先放置，DockPanel 会先处理） -->
					<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6 0 4 0" Spacing="1">
						<!-- Axis/OAction 显示数值 -->
						<TextBlock Text="{Binding Value, StringFormat='{}{0:F2}'}"
								   VerticalAlignment="Center"
								   Width="70"
								   TextAlignment="Right"
								   Margin="0 0 4 0"
								   IsVisible="{Binding ShowNodeValue}"/>
						<!-- OAction 显示 DO 切换按钮 -->
						<Button Classes="node-tool-btn node-do-btn" HorizontalAlignment="Center" VerticalAlignment="Center"
								Command="{Binding ToggleDOCommand}"
								Width="24"
								AutomationProperties.Name="切换输出"
								IsVisible="{Binding ShowBtn}">
							<Panel>
								<iconPacks:PackIconIonicons IsVisible="{Binding Active}" Kind="RadioButtonOniOS"/>
								<iconPacks:PackIconIonicons IsVisible="{Binding !Active}" Kind="RadioButtonOffiOS"/>
							</Panel>
						</Button>
						<!-- Action 显示录制按钮 -->
						<Button Classes="node-tool-btn node-action-btn"
								Name="RecordKeyButton"
								Width="28" Height="28"
								IsVisible="{Binding ShowRecordBtn}"
								ToolTip.Tip="{Binding RecordingToolTip}"
								AutomationProperties.Name="{Binding RecordingToolTip}">
							<Panel HorizontalAlignment="Center" VerticalAlignment="Center">
								<Ellipse Classes="recording-indicator" IsVisible="{Binding IsRecording}"
										 Width="14" Height="14" Fill="{DynamicResource TlDanger}"
										 RenderTransformOrigin="0.5,0.5"/>
								<Ellipse IsVisible="{Binding !IsRecording}" Width="14" Height="14"
										 Stroke="{DynamicResource TlTextMuted}" StrokeThickness="2" />
							</Panel>
						</Button>
						<!-- 编辑按钮仅在全局编辑模式显示，避免现场误修改配置 -->
						<Button Classes="node-tool-btn node-edit-btn"
								Name="EditNodeButton"
								IsVisible="{Binding IsEditMode}"
								ToolTip.Tip="编辑此节点"
								AutomationProperties.Name="编辑此节点">
							<Panel HorizontalAlignment="Center" VerticalAlignment="Center">
								<iconPacks:PackIconIonicons Kind="CreateiOS" Width="14" Height="14" Foreground="{DynamicResource TlAccent}"
															HorizontalAlignment="Center" VerticalAlignment="Center"/>
							</Panel>
						</Button>
					</StackPanel>
					<!-- 名称填充剩余空间 -->
					<TextBlock Text="{Binding DeviceLabel}"
							   Padding="8 8 4 8"
							   FontSize="14"
							   VerticalAlignment="Center"
							   TextTrimming="CharacterEllipsis"
							   ToolTip.Tip="{Binding DeviceLabel}" />
				</DockPanel>
			</Border>

			<!-- 节点按键列表 -->
			<ItemsRepeater ItemsSource="{Binding KeyList}">
				<ItemsRepeater.ItemTemplate>
					<DataTemplate>
						<Border Margin="5 2"
								CornerRadius="3"
								Classes="key-item"
								Classes.editing="{Binding IsEditing}">

							<DockPanel Classes.active="{Binding Active}" LastChildFill="True">
								<!-- 右侧区域 -->
								<StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="6 0 4 0" Spacing="1">
									<!-- Axis/OAction 显示数值 -->
									<TextBlock Text="{Binding Value, StringFormat='{}{0:F2}'}"
											   VerticalAlignment="Center"
											   Width="70"
											   TextAlignment="Right"
											   Margin="0 0 4 0"
											   IsVisible="{Binding $parent[UserControl].DataContext.ShowKeyValue, FallbackValue=False}"/>
									<!-- OAction 显示 DO 切换按钮 -->
									<Button Classes="node-tool-btn node-do-btn" Command="{Binding ToggleDOCommand}"
											HorizontalAlignment="Center" VerticalAlignment="Center"
											Width="24"
											IsVisible="{Binding $parent[UserControl].DataContext.ShowBtn, FallbackValue=False}">
										<Panel>
											<iconPacks:PackIconIonicons IsVisible="{Binding Active}" Kind="RadioButtonOniOS"/>
											<iconPacks:PackIconIonicons IsVisible="{Binding !Active}" Kind="RadioButtonOffiOS"/>
										</Panel>
									</Button>
								</StackPanel>
								<!-- 左侧：名称 + Scale/InvertEvent 标识 -->
								<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
									<TextBlock Text="{Binding Name}" VerticalAlignment="Center" Padding="8 4 0 4" />
									<!-- Axis/OAction: Scale 不为 1 时显示缩放值 -->
											<Border Background="{DynamicResource TlAccentSoftBg}" CornerRadius="4" Padding="6 2" VerticalAlignment="Center"
											IsVisible="{Binding HasCustomScale}"
											ToolTip.Tip="缩放系数">
										<TextBlock Text="{Binding Scale, StringFormat='×{0:G}'}"
															   FontSize="11" Foreground="{DynamicResource TlAccentSoftFg}" VerticalAlignment="Center"/>
									</Border>
									<!-- OAction: InvertEvent 为 True 时显示反转标识 -->
											<Border Background="{DynamicResource TlStatusOfflineBg}" CornerRadius="4" Padding="6 2" VerticalAlignment="Center"
											IsVisible="{Binding InvertEventBool}"
											ToolTip.Tip="事件反转">
										<TextBlock Text="反转" FontSize="11" Foreground="{DynamicResource TlStatusOfflineFg}" VerticalAlignment="Center"/>
									</Border>
								</StackPanel>
							</DockPanel>
						</Border>
					</DataTemplate>
				</ItemsRepeater.ItemTemplate>
			</ItemsRepeater>

			<!-- 当没有Key时显示提示 -->
			<Border IsVisible="{Binding !KeyList.Count}"
					Margin="5 2"
					CornerRadius="3"
					Background="{DynamicResource TlEmptyBg}">
				<TextBlock Text="{Binding ChannelTypeName, StringFormat='请添加{0}'}"
						   FontSize="12"
						   Foreground="{DynamicResource TlTextMuted}"
						   VerticalAlignment="Center"
						   Padding="8 4"
						   MinHeight="28"/>
			</Border>

		</StackPanel>
	</Border>

</UserControl>
