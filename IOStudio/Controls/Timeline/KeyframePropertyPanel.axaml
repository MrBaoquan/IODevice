<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:IOStudio.ViewModels.Timeline"
             xmlns:conv="using:IOStudio.Converters"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             mc:Ignorable="d" d:DesignWidth="320" d:DesignHeight="400"
             x:Class="IOStudio.Controls.Timeline.KeyframePropertyPanel"
             x:DataType="vm:KeyframePropertyViewModel"
             Focusable="True"
             KeyDown="OnPanelKeyDown">

    <UserControl.Resources>
        <conv:TextEqualsConverter x:Key="TextEquals" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- ══════════════════════════════════════════════════════════
             检查器度量令牌 — 全面板只引用这里, 改版只改这一处。
             间距走 4/8/12 阶梯; 字号走 11/12 两档 (标题 12, 正文 11/12);
             控件高度统一 30 (输入) / 30 (导航) / 26 (小动作)。
             ══════════════════════════════════════════════════════════ -->

        <!-- 字段标签: 统一列宽, 保证跨区段左基线对齐 -->
        <Style Selector="TextBlock.prop-label">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TlTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- 数值/时间等度量文本: 等宽 + tabular 需要, 避免数字跳动 -->
        <Style Selector="TextBlock.prop-mono">
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>

        <!-- 区段标题: 统一字号/字重/颜色 -->
        <Style Selector="TextBlock.prop-section-title">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TlTextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 区段标题前的语义点: 非语义区段共用同一令牌 -->
        <Style Selector="Ellipse.prop-dot">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{DynamicResource TlPropSectionDot}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="TextBox.prop-input">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Background" Value="{DynamicResource TlInputBg}"/>
        </Style>
        <Style Selector="ComboBox.prop-combo">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

        <!-- 属性区段: 统一上下留白 (12), 唯一分隔线 -->
        <Style Selector="Border.prop-section">
            <Setter Property="Padding" Value="0,12,0,12"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <!-- 批量操作容器: 把并排的小按钮收进一个浅底分组, 避免"裸按钮堆叠" -->
        <Style Selector="Border.prop-batch">
            <Setter Property="Background" Value="{DynamicResource TlInputBg}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>

        <!-- 导航/工具按钮 (可键盘聚焦; 焦点环见下方统一规则) -->
        <Style Selector="Button.nav-btn">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.nav-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource TlHoverBg}"/>
        </Style>
        <Style Selector="Button.nav-btn:pressed">
            <Setter Property="Background" Value="{DynamicResource TlAccentSoftBg}"/>
        </Style>

        <!-- 小动作按钮 (批量/重置/模板): 26×26, 满足桌面指针目标下限 -->
        <Style Selector="Button.reset-btn">
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TlTextMuted}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.reset-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource TlHoverBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TlTextPrimary}"/>
        </Style>

        <!-- 区段头: 整行可点 (Blender / Resolve 惯例), 箭头只作指示 -->
        <Style Selector="Button.section-head">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="Button.section-head /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.section-head:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TlHoverBg}"/>
        </Style>

        <!-- 颜色色板: 选中项加环 (Resolve 惯例) -->
        <Style Selector="Button.swatch">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="Background" Value="{DynamicResource TlHoverBg}"/>
        </Style>
        <Style Selector="Button.swatch.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TlTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource TlAccentSoftBg}"/>
        </Style>

        <!-- 统一焦点环 (键盘可达; WCAG 2.4.7 / 2.4.13) -->
        <Style Selector="Button:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TlAccent}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>
        <Style Selector="ToggleButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource TlAccent}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
        </Style>

        <!-- 行/区段内的可收缩文本: 一律省略号, 绝不顶出容器 -->
        <Style Selector="TextBlock.prop-value">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TlTextSecondary}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource TlPanelBg}" BorderBrush="{DynamicResource TlBorderBrush}"
            BorderThickness="1,0,0,0" Padding="12,8" MinWidth="240">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <DockPanel>
                <!-- 标题栏: 检查器 + AutoKey + 轨道名 -->
                <Border DockPanel.Dock="Top" Margin="0,0,0,4"
                        BorderBrush="{DynamicResource TlBorderBrush}" BorderThickness="0,0,0,1"
                        Padding="0,0,0,6">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <!-- 轨道颜色指示条 -->
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{Binding TrackColor}" Margin="0,0,6,0"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding HasSelection}"/>
                        <TextBlock Grid.Column="1" Text="{Binding PanelTitle}" FontWeight="SemiBold" FontSize="13"
                                   Foreground="{DynamicResource TlTextPrimary}" VerticalAlignment="Center"/>
                        <!-- AutoKey 切换按钮 -->
                        <ToggleButton Grid.Column="3" Name="AutoKeyToggle"
                                      Focusable="False"
                                      IsVisible="{Binding IsTrackInspector}"
                                      IsChecked="{Binding IsAutoKeyMode}"
                                      Padding="5,3" MinWidth="0" MinHeight="0"
                                      FontSize="10" CornerRadius="3"
                                      ToolTip.Tip="自动关键帧: 编辑时自动在播放头位置创建关键帧">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <iconPacks:PackIconIonicons Kind="RadioButtonOniOS" Width="12" Height="12"
                                                            Foreground="{DynamicResource TlDanger}"/>
                                <TextBlock Text="自动" FontSize="10" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ToggleButton>
                    </Grid>
                </Border>

                <!-- 无选中提示 -->
                <StackPanel IsVisible="{Binding !HasSelection}"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            Spacing="8" Margin="0,40">
                    <iconPacks:PackIconIonicons Kind="KeyiOS" Width="26" Height="26"
                                                Opacity="0.55" HorizontalAlignment="Center"
                                                Foreground="{DynamicResource TlTextMuted}"/>
                    <TextBlock Text="选中一条轨道以显示检查器"
                               FontSize="12" Foreground="{DynamicResource TlTextMuted}"
                               TextAlignment="Center" LineHeight="18"/>
                </StackPanel>

                <!-- 属性编辑区 -->
                <StackPanel IsVisible="{Binding HasSelection}" Spacing="2">

                    <!-- 影片级动作实例摘要 -->
                    <Border Classes="prop-section" IsVisible="{Binding IsActionInstance}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="{Binding ActionName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TlTextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ActionCategory}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TlTextMuted}"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Background="{DynamicResource TlAccentSoftBg}"
                                        CornerRadius="6" Padding="6,2"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding IndexLabel}"
                                               FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TlAccentSoftFg}"
                                               FontFamily="Consolas, monospace"/>
                                </Border>
                            </Grid>
                            <Grid ColumnDefinitions="60,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="7">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="prop-label" Text="时间范围"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ActionTimeRangeText}"
                                           Classes="prop-mono" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TlTextSecondary}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Classes="prop-label" Text="动作参数"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActionParametersText}"
                                           Classes="prop-mono" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TlTextSecondary}"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Classes="prop-label" Text="绑定"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ActionBindingText}"
                                           Classes="prop-value" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                            <Border BorderBrush="{DynamicResource TlBorderBrush}"
                                    BorderThickness="0,1,0,0" Padding="0,8,0,0">
                                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto" ColumnSpacing="3">
                                    <Button Grid.Column="0" Classes="nav-btn" ToolTip.Tip="复制到播放头"
                                            IsEnabled="{Binding !ActionEditLocked}"
                                            Click="OnDuplicateActionClick">
                                        <iconPacks:PackIconIonicons Kind="CopyiOS" Width="15" Height="15"
                                                                    Foreground="{DynamicResource TlTextSecondary}"/>
                                    </Button>
                                    <Button Grid.Column="1" Classes="nav-btn" ToolTip.Tip="移动到播放头"
                                            IsEnabled="{Binding !ActionEditLocked}"
                                            Click="OnMoveActionClick">
                                        <iconPacks:PackIconIonicons Kind="MoveiOS" Width="15" Height="15"
                                                                    Foreground="{DynamicResource TlTextSecondary}"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="nav-btn" ToolTip.Tip="另存为效果预设"
                                            IsEnabled="{Binding !ActionEditLocked}"
                                            Click="OnSaveActionAsPresetClick">
                                        <iconPacks:PackIconIonicons Kind="SaveiOS" Width="15" Height="15"
                                                                    Foreground="{DynamicResource TlTextSecondary}"/>
                                    </Button>
                                    <!-- 重建: 手动改过 clip 后恢复成预设定义的样子 (按项目内快照, 不会因库变化漂移) -->
                                    <Button Grid.Column="3" Classes="nav-btn" ToolTip.Tip="按预设重建（项目内快照）"
                                            IsEnabled="{Binding !ActionEditLocked}"
                                            Click="OnRebuildActionClick">
                                        <iconPacks:PackIconIonicons Kind="RefreshiOS" Width="15" Height="15"
                                                                    Foreground="{DynamicResource TlTextSecondary}"/>
                                    </Button>
                                    <!-- 从库更新并重建: 改了预设后让已放置实例跟着更新 -->
                                    <Button Grid.Column="4" Classes="nav-btn" ToolTip.Tip="从预设库更新并重建"
                                            IsEnabled="{Binding !ActionEditLocked}"
                                            Click="OnRebuildFromLibraryClick">
                                        <iconPacks:PackIconIonicons Kind="CloudDownloadiOS" Width="15" Height="15"
                                                                    Foreground="{DynamicResource TlTextSecondary}"/>
                                    </Button>
                                    <Border Grid.Column="6" Width="1" Height="18"
                                            Margin="5,0,2,0" VerticalAlignment="Center"
                                            Background="{DynamicResource TlBorderBrush}"/>
                                    <Button Grid.Column="7" Classes="nav-btn" ToolTip.Tip="删除动作（可撤销）"
                                            IsEnabled="{Binding !ActionEditLocked}"
                                            Click="OnDeleteActionClick">
                                        <iconPacks:PackIconIonicons Kind="TrashiOS" Width="15" Height="15"
                                                                    Foreground="{DynamicResource TlDanger}"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Selection context and keyframe navigation -->
                    <Border Classes="prop-section" IsVisible="{Binding IsTrackInspector}">
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                            <!-- 轨道名 + 时间 -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Ellipse Width="7" Height="7" Fill="{Binding TrackColor}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TrackName}"
                                               FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TlTextPrimary}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding TimeDisplayText}"
                                           Classes="prop-mono"
                                           Foreground="{DynamicResource TlTextMuted}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- ◀ 前一个关键帧 -->
                            <Button Grid.Column="1" Classes="nav-btn"
                                    ToolTip.Tip="跳转到前一个关键帧"
                                    Click="OnPrevKeyframeClick">
                                <iconPacks:PackIconIonicons Kind="ArrowBackiOS" Width="13" Height="13"
                                                            Foreground="{DynamicResource TlTextMuted}"/>
                            </Button>
                            <!-- ◆ 切换关键帧 -->
                            <Button Grid.Column="2" Classes="nav-btn"
                                    ToolTip.Tip="在播放头位置添加/删除关键帧"
                                    Click="OnToggleKeyframeClick">
                                <Panel>
                                    <iconPacks:PackIconIonicons Kind="RadioButtonOniOS" Width="14" Height="14"
                                                                Foreground="{DynamicResource TlDanger}"
                                                                IsVisible="{Binding HasKeyframeAtPlayhead}"/>
                                    <iconPacks:PackIconIonicons Kind="RadioButtonOffiOS" Width="14" Height="14"
                                                                Foreground="{DynamicResource TlTextMuted}"
                                                                IsVisible="{Binding !HasKeyframeAtPlayhead}"/>
                                </Panel>
                            </Button>
                            <!-- ▶ 后一个关键帧 -->
                            <Button Grid.Column="3" Classes="nav-btn"
                                    ToolTip.Tip="跳转到后一个关键帧"
                                    Click="OnNextKeyframeClick">
                                <iconPacks:PackIconIonicons Kind="ArrowForwardiOS" Width="13" Height="13"
                                                            Foreground="{DynamicResource TlTextMuted}"/>
                            </Button>
                            <!-- 状态标签 -->
                            <TextBlock Grid.Column="4" Text="{Binding IndexLabel}"
                                       Classes="prop-mono" Foreground="{DynamicResource TlTextMuted}"
                                       VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- ═══ 关键帧列表 (当前 clip; 点击跳转) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding IsTrackInspector}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="prop-dot"/>
                                    <TextBlock Text="关键帧" Classes="prop-section-title"/>
                                </StackPanel>
                            </Grid>
                            <!-- 空态: 说明原因 + 下一步动作 (列表隐藏时不至于只剩一排按钮) -->
                            <TextBlock Text="{Binding KeyframeListEmptyText}"
                                       IsVisible="{Binding ShowKeyframeListEmpty}"
                                       Classes="prop-value" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TlTextMuted}"/>
                            <ListBox Name="KeyframeListBox"
                                     ItemsSource="{Binding KeyframeItems}"
                                     IsVisible="{Binding HasKeyframeList}"
                                     MaxHeight="170" SelectionMode="Multiple"
                                     SelectionChanged="OnKeyframeListItemChanged"
                                     Background="{DynamicResource TlInputBg}"
                                     CornerRadius="6" Padding="2">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:KeyframeListItem">
                                        <Grid ColumnDefinitions="32,*,70,60" Height="24">
                                            <TextBlock Grid.Column="0" Text="{Binding IndexText}" Classes="prop-mono"
                                                       Foreground="{DynamicResource TlTextMuted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TimeText}" Classes="prop-mono"
                                                       Foreground="{DynamicResource TlTextSecondary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding ValueText}" Classes="prop-mono"
                                                       Foreground="{DynamicResource TlTextPrimary}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding Interpolation}" Classes="prop-mono"
                                                       Foreground="{DynamicResource TlTextMuted}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <!-- 批量操作: 收进浅底分组; 无可编辑关键帧时整组禁用 -->
                            <Border Classes="prop-batch" IsEnabled="{Binding HasKeyframeList}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="插值" Classes="prop-label" MinWidth="0"/>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Classes="reset-btn" Content="Linear" Margin="0,0,4,4" Click="OnApplyClipInterpolationClick" Tag="linear"/>
                                            <Button Classes="reset-btn" Content="Bezier" Margin="0,0,4,4" Click="OnApplyClipInterpolationClick" Tag="bezier"/>
                                            <Button Classes="reset-btn" Content="Step" Margin="0,0,4,4" Click="OnApplyClipInterpolationClick" Tag="step"/>
                                            <Button Classes="reset-btn" Content="Ease" Margin="0,0,4,4" Click="OnApplyClipInterpolationClick" Tag="ease_in_out"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="值" Classes="prop-label" MinWidth="0"/>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Classes="reset-btn" Content="−0.01" Margin="0,0,4,4" Click="OnBatchValueClick" Tag="offset:-0.01"/>
                                            <Button Classes="reset-btn" Content="+0.01" Margin="0,0,4,4" Click="OnBatchValueClick" Tag="offset:0.01"/>
                                            <Button Classes="reset-btn" Content="×0.9" Margin="0,0,4,4" Click="OnBatchValueClick" Tag="scale:0.9"/>
                                            <Button Classes="reset-btn" Content="×1.1" Margin="0,0,4,4" Click="OnBatchValueClick" Tag="scale:1.1"/>
                                        </WrapPanel>
                                    </Grid>
                                    <Grid ColumnDefinitions="34,*" ColumnSpacing="4">
                                        <TextBlock Grid.Column="0" Text="时间" Classes="prop-label" MinWidth="0"/>
                                        <WrapPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Classes="reset-btn" Content="对齐播放头" Margin="0,0,4,4"
                                                    Click="OnBatchTimeOpClick" Tag="align"
                                                    ToolTip.Tip="选中块起点对齐到播放头"/>
                                            <Button Classes="reset-btn" Content="÷2" Margin="0,0,4,4"
                                                    Click="OnBatchTimeOpClick" Tag="scale:0.5"/>
                                            <Button Classes="reset-btn" Content="×2" Margin="0,0,4,4"
                                                    Click="OnBatchTimeOpClick" Tag="scale:2"/>
                                            <Button Classes="reset-btn" Content="反向" Margin="0,0,4,4"
                                                    Click="OnBatchTimeOpClick" Tag="reverse"
                                                    ToolTip.Tip="在选中块时间跨度内镜像"/>
                                            <Button Classes="reset-btn" Content="量化节拍" Margin="0,0,4,4"
                                                    Click="OnBatchTimeOpClick" Tag="quantize"
                                                    ToolTip.Tip="吸附到最近节拍标记 (需先开启节拍检测)"/>
                                        </WrapPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 值 区段 (Float): 滑块+输入框同行 (参考 DaVinci 音调面板) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding IsFloatMode}">
                        <StackPanel Spacing="4">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="prop-dot"/>
                                    <TextBlock Text="数值" Classes="prop-section-title"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="reset-btn"
                                        ToolTip.Tip="重置为 0.5"
                                        Click="OnResetValueClick">
                                    <iconPacks:PackIconIonicons Kind="RefreshiOS" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                            <!-- 滑块 + 数值输入 同行布局 (主流: 拖拽数值框即可微调) -->
                            <Grid ColumnDefinitions="*,80" IsEnabled="{Binding IsValueEditable}">
                                <Slider Name="ValueSlider" Grid.Column="0"
                                        Minimum="0" Maximum="1"
                                        TickFrequency="0.01"
                                        IsSnapToTickEnabled="False"
                                        Value="{Binding Value}"
                                        Focusable="False"
                                        ValueChanged="OnValueSliderChanged"
                                        VerticalAlignment="Center"
                                        Height="28"/>
                                <TextBox Name="ValueInput" Grid.Column="1"
                                         Classes="prop-input" Margin="6,0,0,0"
                                         Text="{Binding ValueDisplayText, Mode=OneWay}"
                                         ToolTip.Tip="左右拖动微调 · 单击输入 · Alt+↑↓ 步进"
                                         Cursor="SizeWestEast"
                                         GotFocus="OnInputGotFocus"
                                         LostFocus="OnValueLostFocus"
                                         KeyDown="OnValueKeyDown"
                                         PointerPressed="OnValueScrubStart"
                                         PointerMoved="OnValueScrubMove"
                                         PointerReleased="OnValueScrubEnd"
                                         HorizontalContentAlignment="Center"/>
                            </Grid>
                            <!-- 工程量: 与归一化值并列, 直接看到设备实际值 -->
                            <TextBlock Text="{Binding EngineeringText}"
                                       IsVisible="{Binding ShowEngineering}"
                                       FontSize="10" Foreground="{DynamicResource TlTextMuted}"
                                       HorizontalAlignment="Right"/>
                            <!-- 编辑提示 (原因化) + 一键启用自动 -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"
                                  IsVisible="{Binding ShowEditHint}" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="{Binding EditHintText}"
                                           FontSize="11" Foreground="{DynamicResource TlTextMuted}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Opacity="0.9"/>
                                <Button Grid.Column="1" Classes="reset-btn" Content="启用自动"
                                        IsVisible="{Binding CanEnableAuto}"
                                        Click="OnEnableAutoClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 值 区段 (Bool) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding IsBoolMode}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="prop-dot"/>
                                <TextBlock Text="开关" Classes="prop-section-title"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <ToggleSwitch Name="BoolToggle" Grid.Column="0"
                                              Focusable="False"
                                              OnContent="开 (1)" OffContent="关 (0)"
                                              IsChecked="{Binding BoolValue}"
                                              IsEnabled="{Binding IsValueEditable}"
                                              IsCheckedChanged="OnBoolToggleChanged"/>
                                <TextBlock Text="{Binding BoolValueLabel}" Grid.Column="1"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TlTextMuted}" VerticalAlignment="Center"
                                           Margin="6,0,0,0"/>
                            </Grid>
                            <!-- 编辑提示 (原因化) + 一键启用自动 -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"
                                  IsVisible="{Binding ShowEditHint}" Margin="0,4,0,0">
                                <TextBlock Grid.Column="0" Text="{Binding EditHintText}"
                                           FontSize="11" Foreground="{DynamicResource TlTextMuted}"
                                           VerticalAlignment="Center" TextWrapping="Wrap"
                                           Opacity="0.9"/>
                                <Button Grid.Column="1" Classes="reset-btn" Content="启用自动"
                                        IsVisible="{Binding CanEnableAuto}"
                                        Click="OnEnableAutoClick"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 多选统计 -->
                    <Border Classes="prop-section" IsVisible="{Binding IsMultiSelect}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="prop-dot" Fill="{DynamicResource TlWarning}"/>
                                <TextBlock Text="多选统计" Classes="prop-section-title"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="值范围" Grid.Column="0"/>
                                <TextBox Classes="prop-input" IsReadOnly="True" Grid.Column="1"
                                         Text="{Binding ValueDisplayText, Mode=OneWay}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 待机循环 区段 (辅助; 可折叠, 默认收起) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding IsTrackInspector}">
                        <StackPanel Spacing="6">
                            <!-- 整行可点 (主流 Inspector 惯例); 箭头仅作指示 -->
                            <Button Classes="section-head" Tag="idle"
                                    Click="OnToggleSectionClick" ToolTip.Tip="展开 / 收起">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="prop-dot"/>
                                        <TextBlock Text="待机循环" Classes="prop-section-title"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding IdleStatusText}"
                                               Classes="prop-value" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TlTextMuted}"/>
                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                        <iconPacks:PackIconIonicons Kind="ArrowDowniOS" Width="12" Height="12"
                                                                    IsVisible="{Binding IsIdleSectionExpanded}"
                                                                    Foreground="{DynamicResource TlTextMuted}"/>
                                        <iconPacks:PackIconIonicons Kind="ArrowForwardiOS" Width="12" Height="12"
                                                                    IsVisible="{Binding !IsIdleSectionExpanded}"
                                                                    Foreground="{DynamicResource TlTextMuted}"/>
                                    </Panel>
                                </Grid>
                            </Button>
                            <StackPanel Spacing="6" IsVisible="{Binding IsIdleSectionExpanded}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                    <Button Grid.Column="0" Classes="reset-btn" Cursor="Hand"
                                            Command="{Binding $parent[Window].((vm:TimelineEditorViewModel)DataContext).ToggleTrackIdleCommand}"
                                            CommandParameter="{Binding TrackVm}">
                                        <TextBlock Text="切换待机" FontSize="11"/>
                                    </Button>
                                    <Button Grid.Column="2" Classes="reset-btn" Cursor="Hand"
                                            Command="{Binding $parent[Window].((vm:TimelineEditorViewModel)DataContext).EditTrackIdleCommand}"
                                            CommandParameter="{Binding TrackVm}">
                                        <TextBlock Text="编辑曲线…" FontSize="11"/>
                                    </Button>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="模板:" Classes="prop-label" MinWidth="0"/>
                                    <Button Classes="reset-btn" Cursor="Hand" Content="呼吸"
                                            Command="{Binding $parent[Window].((vm:TimelineEditorViewModel)DataContext).ApplyIdleTemplateToTrackCommand}"
                                            CommandParameter="breathing"/>
                                    <Button Classes="reset-btn" Cursor="Hand" Content="摇摆"
                                            Command="{Binding $parent[Window].((vm:TimelineEditorViewModel)DataContext).ApplyIdleTemplateToTrackCommand}"
                                            CommandParameter="sway"/>
                                    <Button Classes="reset-btn" Cursor="Hand" Content="微幅"
                                            Command="{Binding $parent[Window].((vm:TimelineEditorViewModel)DataContext).ApplyIdleTemplateToTrackCommand}"
                                            CommandParameter="micro"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 插值 区段 (仅播放头在关键帧上时显示) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding ShowInterpolation}">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                    <Ellipse Classes="prop-dot"/>
                                    <TextBlock Text="插值" Classes="prop-section-title"/>
                                </StackPanel>
                                <Button Grid.Column="1" Classes="reset-btn"
                                        ToolTip.Tip="重置为 Linear"
                                        Click="OnResetInterpolationClick">
                                    <iconPacks:PackIconIonicons Kind="RefreshiOS" Width="13" Height="13"/>
                                </Button>
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="类型" Grid.Column="0"/>
                                <ComboBox Name="InterpolationCombo" Classes="prop-combo" Grid.Column="1"
                                          Focusable="False"
                                          SelectionChanged="OnInterpolationChanged">
                                    <ComboBoxItem Content="Linear (线性)" Tag="linear"/>
                                    <ComboBoxItem Content="Bezier (贝塞尔)" Tag="bezier"/>
                                    <ComboBoxItem Content="Step (阶梯)" Tag="step"/>
                                    <ComboBoxItem Content="Ease In/Out (缓入缓出)" Tag="ease_in_out"/>
                                </ComboBox>
                            </Grid>
                            <!-- 关键帧时间 (绝对时间, 可直接输入微调) -->
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="时间" Grid.Column="0"
                                           ToolTip.Tip="关键帧绝对时间: 毫秒 (3250) 或 00:03.250"/>
                                <TextBox Name="KeyframeTimeInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="毫秒 或 00:03.250"
                                         Text="{Binding KeyframeTimeText, Mode=OneWay}"
                                         LostFocus="OnKeyframeTimeCommit"
                                         KeyDown="OnKeyframeTimeKeyDown"/>
                            </Grid>
                            <!-- 贝塞尔切线数值 (仅 bezier) -->
                            <Grid ColumnDefinitions="60,*" IsVisible="{Binding ShowTangent}">
                                <TextBlock Classes="prop-label" Text="切线入" Grid.Column="0"
                                           ToolTip.Tip="入切线纵坐标 (控制点 Y)"/>
                                <TextBox Name="TangentInInput" Classes="prop-input" Grid.Column="1"
                                         Text="{Binding TangentIn, Mode=OneWay}"
                                         LostFocus="OnTangentLostFocus" KeyDown="OnTangentKeyDown"/>
                            </Grid>
                            <Grid ColumnDefinitions="60,*" IsVisible="{Binding ShowTangent}">
                                <TextBlock Classes="prop-label" Text="切线出" Grid.Column="0"
                                           ToolTip.Tip="出切线纵坐标 (控制点 Y)"/>
                                <TextBox Name="TangentOutInput" Classes="prop-input" Grid.Column="1"
                                         Text="{Binding TangentOut, Mode=OneWay}"
                                         LostFocus="OnTangentLostFocus" KeyDown="OnTangentKeyDown"/>
                            </Grid>
                            <!-- 贝塞尔控制点 X (决定切线的时间展布, 仅 bezier) -->
                            <Grid ColumnDefinitions="60,*" IsVisible="{Binding ShowTangent}">
                                <TextBlock Classes="prop-label" Text="入控制点X" Grid.Column="0"
                                           ToolTip.Tip="入控制点横坐标 (0.2 ~ 3.0), 越大越晚发力"/>
                                <TextBox Name="Cp1xInput" Classes="prop-input" Grid.Column="1"
                                          Text="{Binding Cp1x, Mode=OneWay}"
                                          LostFocus="OnTangentLostFocus" KeyDown="OnTangentKeyDown"/>
                            </Grid>
                            <Grid ColumnDefinitions="60,*" IsVisible="{Binding ShowTangent}">
                                <TextBlock Classes="prop-label" Text="出控制点X" Grid.Column="0"
                                           ToolTip.Tip="出控制点横坐标 (0.2 ~ 3.0), 越大越晚收尾"/>
                                <TextBox Name="Cp2xInput" Classes="prop-input" Grid.Column="1"
                                          Text="{Binding Cp2x, Mode=OneWay}"
                                          LostFocus="OnTangentLostFocus" KeyDown="OnTangentKeyDown"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 标记属性 (播放头落在标记上; 可折叠) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding ShowMarkerEditor}">
                        <StackPanel Spacing="6">
                            <Button Classes="section-head" Tag="marker"
                                    Click="OnToggleSectionClick" ToolTip.Tip="展开 / 收起">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="prop-dot" Fill="{Binding MarkerColor}"/>
                                        <TextBlock Text="标记" Classes="prop-section-title"/>
                                        <TextBlock Text="{Binding MarkerName}" Classes="prop-value"
                                                   Foreground="{DynamicResource TlTextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Panel Grid.Column="1" VerticalAlignment="Center">
                                        <iconPacks:PackIconIonicons Kind="ArrowDowniOS" Width="12" Height="12"
                                                                    IsVisible="{Binding IsMarkerSectionExpanded}"
                                                                    Foreground="{DynamicResource TlTextMuted}"/>
                                        <iconPacks:PackIconIonicons Kind="ArrowForwardiOS" Width="12" Height="12"
                                                                    IsVisible="{Binding !IsMarkerSectionExpanded}"
                                                                    Foreground="{DynamicResource TlTextMuted}"/>
                                    </Panel>
                                </Grid>
                            </Button>
                            <StackPanel Spacing="6" IsVisible="{Binding IsMarkerSectionExpanded}">
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="名称" Grid.Column="0"/>
                                <TextBox Name="MarkerNameInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="标记名称"
                                         Text="{Binding MarkerName, Mode=TwoWay}"
                                         LostFocus="OnMarkerLostFocus" KeyDown="OnMarkerKeyDown"/>
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="备注" Grid.Column="0"/>
                                <TextBox Name="MarkerNoteInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="备注 (可选)"
                                         Text="{Binding MarkerNote, Mode=TwoWay}"
                                         LostFocus="OnMarkerLostFocus" KeyDown="OnMarkerKeyDown"/>
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="颜色" Grid.Column="0"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <!-- 当前颜色: 选中项加环 (Resolve 惯例) -->
                                    <Button Classes="swatch" Click="OnMarkerColorClick" Tag="#f59e0b"
                                            Classes.selected="{Binding MarkerColor, Converter={StaticResource TextEquals}, ConverterParameter=#f59e0b}"
                                            ToolTip.Tip="琥珀"><Ellipse Width="12" Height="12" Fill="#f59e0b"/></Button>
                                    <Button Classes="swatch" Click="OnMarkerColorClick" Tag="#ef4444"
                                            Classes.selected="{Binding MarkerColor, Converter={StaticResource TextEquals}, ConverterParameter=#ef4444}"
                                            ToolTip.Tip="红"><Ellipse Width="12" Height="12" Fill="#ef4444"/></Button>
                                    <Button Classes="swatch" Click="OnMarkerColorClick" Tag="#22c55e"
                                            Classes.selected="{Binding MarkerColor, Converter={StaticResource TextEquals}, ConverterParameter=#22c55e}"
                                            ToolTip.Tip="绿"><Ellipse Width="12" Height="12" Fill="#22c55e"/></Button>
                                    <Button Classes="swatch" Click="OnMarkerColorClick" Tag="#3b82f6"
                                            Classes.selected="{Binding MarkerColor, Converter={StaticResource TextEquals}, ConverterParameter=#3b82f6}"
                                            ToolTip.Tip="蓝"><Ellipse Width="12" Height="12" Fill="#3b82f6"/></Button>
                                    <Button Classes="swatch" Click="OnMarkerColorClick" Tag="#a855f7"
                                            Classes.selected="{Binding MarkerColor, Converter={StaticResource TextEquals}, ConverterParameter=#a855f7}"
                                            ToolTip.Tip="紫"><Ellipse Width="12" Height="12" Fill="#a855f7"/></Button>
                                    <Button Classes="swatch" Click="OnMarkerColorClick" Tag="#ec4899"
                                            Classes.selected="{Binding MarkerColor, Converter={StaticResource TextEquals}, ConverterParameter=#ec4899}"
                                            ToolTip.Tip="粉"><Ellipse Width="12" Height="12" Fill="#ec4899"/></Button>
                                </StackPanel>
                            </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 事件 区段 (独立事件 或 播放头位置事件; 可折叠) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding ShowEventBinding}">
                        <StackPanel Spacing="6">
                            <Button Classes="section-head" Tag="event"
                                    Click="OnToggleSectionClick" ToolTip.Tip="展开 / 收起">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="prop-dot" Fill="{DynamicResource TlEvent}"/>
                                        <TextBlock Text="事件" Classes="prop-section-title"/>
                                        <TextBlock Text="{Binding EventBadge}" Classes="prop-value"
                                                   Foreground="{DynamicResource TlTextMuted}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding EventName}" Classes="prop-mono"
                                               Foreground="{DynamicResource TlTextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                        <iconPacks:PackIconIonicons Kind="ArrowDowniOS" Width="12" Height="12"
                                                                    IsVisible="{Binding IsEventSectionExpanded}"
                                                                    Foreground="{DynamicResource TlTextMuted}"/>
                                        <iconPacks:PackIconIonicons Kind="ArrowForwardiOS" Width="12" Height="12"
                                                                    IsVisible="{Binding !IsEventSectionExpanded}"
                                                                    Foreground="{DynamicResource TlTextMuted}"/>
                                    </Panel>
                                </Grid>
                            </Button>
                            <StackPanel Spacing="6" IsVisible="{Binding IsEventSectionExpanded}">
                            <!-- 事件时间 (独立事件可编辑) -->
                            <Grid ColumnDefinitions="60,*"
                                  IsVisible="{Binding IsStandaloneEvent}">
                                <TextBlock Classes="prop-label" Text="时间" Grid.Column="0"/>
                                <TextBox Name="EventTimeInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="MM:SS.fff"
                                         Text="{Binding EventTimeText, Mode=TwoWay}"
                                         LostFocus="OnEventLostFocus"
                                         KeyDown="OnEventKeyDown"/>
                            </Grid>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="名称" Grid.Column="0"/>
                                <TextBox Name="EventNameInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="例: on_impact"
                                         Text="{Binding EventName, Mode=TwoWay}"
                                         LostFocus="OnEventLostFocus"
                                         KeyDown="OnEventKeyDown"/>
                            </Grid>
                            <TextBlock Text="事件名称重复，请使用唯一名称"
                                       IsVisible="{Binding EventNameDuplicate}"
                                       FontSize="10" Foreground="{DynamicResource TlDanger}"
                                       Margin="60,0,0,0"/>
                            <!-- 数据类型选择 -->
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="类型" Grid.Column="0"/>
                                <ComboBox Name="EventDataTypeCombo" Grid.Column="1" Classes="prop-combo"
                                          SelectionChanged="OnEventDataTypeChanged">
                                    <ComboBoxItem Content="none" Tag="none"/>
                                    <ComboBoxItem Content="string" Tag="string"/>
                                    <ComboBoxItem Content="json" Tag="json"/>
                                    <ComboBoxItem Content="number" Tag="number"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="60,*"
                                  IsVisible="{Binding ShowEventDataInput}">
                                <TextBlock Classes="prop-label" Text="事件参数" Grid.Column="0"/>
                                <TextBox Name="EventDataInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="{Binding EventDataWatermark}"
                                         AcceptsReturn="True" MinHeight="36"
                                         TextWrapping="Wrap"
                                         Text="{Binding EventData, Mode=TwoWay}"
                                         LostFocus="OnEventLostFocus"/>
                            </Grid>
                            <TextBlock Text="{Binding EventDataError}"
                                       IsVisible="{Binding EventDataError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       FontSize="10" Foreground="{DynamicResource TlDanger}"
                                       Margin="60,0,0,0"/>
                            <!-- 删除事件按钮 -->
                            <Button Focusable="False"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Padding="6,6" Margin="0,4,0,0"
                                    Background="Transparent" Foreground="{DynamicResource TlDanger}"
                                    BorderBrush="{DynamicResource TlDanger}" BorderThickness="1"
                                    CornerRadius="6"
                                    Command="{Binding DeleteCommand}"
                                    IsVisible="{Binding IsStandaloneEvent}"
                                    Cursor="Hand">
                                <TextBlock Text="删除事件" FontSize="11"/>
                            </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ═══ 播放头事件提示 (轨道检查器模式下，播放头在事件位置时显示) ═══ -->
                    <Border Classes="prop-section" IsVisible="{Binding ShowPlayheadEvent}">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse Classes="prop-dot" Fill="{DynamicResource TlEvent}"/>
                                <TextBlock Text="播放头事件" Classes="prop-section-title"/>
                            </StackPanel>
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="名称" Grid.Column="0"/>
                                <TextBox Name="PlayheadEventNameInput" Classes="prop-input" Grid.Column="1"
                                         Text="{Binding PlayheadEventName, Mode=TwoWay}"
                                         LostFocus="OnPlayheadEventLostFocus"
                                         KeyDown="OnPlayheadEventKeyDown"/>
                            </Grid>
                            <!-- 数据类型选择 -->
                            <Grid ColumnDefinitions="60,*">
                                <TextBlock Classes="prop-label" Text="类型" Grid.Column="0"/>
                                <ComboBox Name="PlayheadEventDataTypeCombo" Grid.Column="1" Classes="prop-combo"
                                          SelectionChanged="OnPlayheadEventDataTypeChanged">
                                    <ComboBoxItem Content="none" Tag="none"/>
                                    <ComboBoxItem Content="string" Tag="string"/>
                                    <ComboBoxItem Content="json" Tag="json"/>
                                    <ComboBoxItem Content="number" Tag="number"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="60,*"
                                  IsVisible="{Binding ShowPlayheadEventDataInput}">
                                <TextBlock Classes="prop-label" Text="参数" Grid.Column="0"/>
                                <TextBox Name="PlayheadEventDataInput" Classes="prop-input" Grid.Column="1"
                                         Watermark="{Binding PlayheadEventDataWatermark}"
                                         AcceptsReturn="True" MinHeight="36"
                                         TextWrapping="Wrap"
                                         Text="{Binding PlayheadEventData, Mode=TwoWay}"
                                         LostFocus="OnPlayheadEventLostFocus"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </DockPanel>
        </ScrollViewer>
    </Border>
</UserControl>
