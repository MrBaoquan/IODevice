<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:IOStudio.ViewModels"
        xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
        xmlns:views="using:IOStudio.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="730"
        x:Class="IOStudio.Views.ProtocolTestWindow"
        x:DataType="vm:ProtocolTestViewModel"
        Title="协议测试台"
        Width="1200" Height="730"
        MinWidth="1024" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource TlWindowBg}"
        Icon="/Assets/avalonia-logo.ico">

    <Design.DataContext>
        <vm:ProtocolTestViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <StyleInclude Source="avares://IOStudio/Views/ProtocolPanelStyles.axaml"/>
    </Window.Styles>

    <DockPanel>

        <!-- ═════════════════════ 工具条: 会话级 / 全局动作 ═════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource TlToolbarBg}"
                BorderBrush="{DynamicResource TlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,7">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="会话" Classes="inline-cap"/>
                    <Button Classes="primary" Command="{Binding NewSessionCommand}"
                            AutomationProperties.AutomationId="ProtocolNewSession"
                            ToolTip.Tip="新开一路与当前同类型的会话并立即启动">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <iconPacks:PackIconIonicons Kind="AddiOS" Width="15" Height="15"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TlAccentFg}"/>
                            <TextBlock Text="新建会话" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="vsep"/>

                    <TextBlock Text="场景" Classes="inline-cap"/>
                    <ComboBox Width="210"
                              ItemsSource="{Binding Scenarios}"
                              SelectedItem="{Binding SelectedScenario}"
                              AutomationProperties.AutomationId="ProtocolScenario"
                              AutomationProperties.Name="内置场景"
                              ToolTip.Tip="Config/ProtocolTests/*.json —— 与 CLI --protocol-test 共用同一套执行器"/>
                    <Button Classes="tool" Command="{Binding RunScenarioCommand}"
                            AutomationProperties.AutomationId="ProtocolRunScenario"
                            ToolTip.Tip="执行选中场景, 结论写到「场景运行」会话">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <iconPacks:PackIconIonicons Kind="PlayiOS" Width="14" Height="14"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TlTextSecondary}"/>
                            <TextBlock Text="运行" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="导出格式" Classes="inline-cap"/>
                    <ComboBox Width="94"
                              ItemsSource="{Binding ExportFormats}"
                              SelectedItem="{Binding ExportFormat}"
                              AutomationProperties.AutomationId="ProtocolExportFormat"
                              AutomationProperties.Name="导出格式"/>
                    <Button Classes="tool" Command="{Binding ExportCommand}"
                            AutomationProperties.AutomationId="ProtocolExport"
                            ToolTip.Tip="按选中会话导出到 Logs/ProtocolTests/">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <iconPacks:PackIconIonicons Kind="DocumentiOS" Width="14" Height="14"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TlTextSecondary}"/>
                            <TextBlock Text="导出" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="tool" Command="{Binding SaveWorkspaceCommand}"
                            AutomationProperties.AutomationId="ProtocolSaveWorkspace"
                            ToolTip.Tip="把当前会话配置落盘 (不含日志)">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <iconPacks:PackIconIonicons Kind="SaveiOS" Width="14" Height="14"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TlTextSecondary}"/>
                            <TextBlock Text="保存配置" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═════════════════════ 会话标签条 (并行会话 = 并行标签) ═════════════════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource TlPanelBg}"
                BorderBrush="{DynamicResource TlBorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,0,12,0"
                Height="36">
            <Grid ColumnDefinitions="*,Auto">
                <ListBox Grid.Column="0"
                         x:Name="SessionList"
                         Classes="plain tabs"
                         VerticalAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         AutomationProperties.AutomationId="ProtocolSessionList"
                         AutomationProperties.Name="会话标签"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ProtocolSessionViewModel">
                            <Border Classes="tab"
                                    Classes.selected="{Binding $parent[ListBoxItem].IsSelected}"
                                    ToolTip.Tip="{Binding StatusText}">
                                <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                    <iconPacks:PackIconIonicons Kind="PlayiOS" Width="11" Height="11"
                                                                IsVisible="{Binding IsVirtual}"
                                                                VerticalAlignment="Center"
                                                                Foreground="{DynamicResource TlTextMuted}"/>
                                    <Ellipse Classes="dot" Classes.running="{Binding IsRunning}"/>
                                    <TextBlock Classes="tab-name" Text="{Binding Label}"
                                               VerticalAlignment="Center"/>
                                    <Border Classes="tab-badge"
                                            Classes.error="{Binding HasErrorSinceSeen}"
                                            IsVisible="{Binding HasUnseen}"
                                            ToolTip.Tip="非当前会话收到的帧数 / 异常">
                                        <TextBlock Text="{Binding BadgeText}"/>
                                    </Border>
                                    <Button Classes="tabbtn"
                                            Command="{Binding DetachCommand}"
                                            IsVisible="{Binding !IsVirtual}"
                                            AutomationProperties.AutomationId="ProtocolSessionDetach"
                                            ToolTip.Tip="在独立窗口打开">
                                        <iconPacks:PackIconIonicons Kind="OpeniOS" Width="12" Height="12"/>
                                    </Button>
                                    <Button Classes="tabbtn"
                                            Command="{Binding CloseCommand}"
                                            AutomationProperties.AutomationId="ProtocolSessionClose"
                                            ToolTip.Tip="关闭会话">
                                        <iconPacks:PackIconIonicons Kind="CloseiOS" Width="12" Height="12"/>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 新建会话: 收在标签条尾部 (浏览器/终端惯例), 与工具条上的主按钮并存 -->
                <Button Grid.Column="1" Classes="iconbtn" VerticalAlignment="Center"
                        Command="{Binding NewSessionCommand}"
                        AutomationProperties.AutomationId="ProtocolNewTab"
                        ToolTip.Tip="新建会话 (与当前同类型)">
                    <iconPacks:PackIconIonicons Kind="AddiOS" Width="16" Height="16"
                                                Foreground="{DynamicResource TlTextSecondary}"/>
                </Button>
            </Grid>
        </Border>

        <!-- ═════════════════════ 状态栏 ═════════════════════ -->
        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource TlToolbarBg}"
                BorderBrush="{DynamicResource TlBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,0"
                Height="24">
            <Grid ColumnDefinitions="*,Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                           FontSize="{DynamicResource TlFontXs}"
                           Foreground="{DynamicResource TlTextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedSession.StatsText}"
                           IsVisible="{Binding HasSelection}"
                           FontSize="{DynamicResource TlFontXs}"
                           Foreground="{DynamicResource TlTextMuted}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"
                           Margin="0,0,14,0"/>
                <TextBlock Grid.Column="2" Text="{Binding Sessions.Count, StringFormat='会话 {0}'}"
                           FontSize="{DynamicResource TlFontXs}"
                           Foreground="{DynamicResource TlTextMuted}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═════════════════════ 主区 ═════════════════════ -->
        <Grid>

            <!-- 未选择会话 -->
            <StackPanel Spacing="10"
                        IsVisible="{Binding !HasSelection}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <iconPacks:PackIconIonicons Kind="PulseiOS" Width="34" Height="34"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource TlTextMuted}"/>
                <TextBlock Text="未选择会话" FontSize="{DynamicResource TlFontM}"
                           Foreground="{DynamicResource TlTextMuted}"/>
                <TextBlock Text="在顶部新建或选择一路会话开始调试"
                           FontSize="{DynamicResource TlFontXs}"
                           Foreground="{DynamicResource TlTextMuted}"/>
            </StackPanel>

            <!-- 分段布局: 连接 → 日志(占满) → 发送 → 工具 -->
            <Grid IsVisible="{Binding HasSelection}">
                <views:ProtocolSessionPanel DataContext="{Binding SelectedSession}"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
