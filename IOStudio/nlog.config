<?xml version="1.0" encoding="utf-8" ?>
<!--
  IOStudio 日志配置 (NLog)。

  现场排查时可直接改本文件, 无需重新编译:
    · 想看更细的过程        → 把 <rules> 里的 minlevel 由 Info 改为 Debug
    · 想减少日志量          → 改为 Warn
    · 想调整保留份数/大小    → 改 maxArchiveFiles / archiveAboveSize
  改动后重启 IOStudio 生效。

  落盘位置: <exe 目录>/Logs/IOStudio-yyyyMMdd.log (与 IODevice C++ 侧日志同目录)
  归档位置: <exe 目录>/Logs/archive/

  说明: keepFileOpen=false 让日志文件在运行中即可被打开查看 (便于边操作边看);
  同步写入 (未启用 async 包装) 以保证崩溃前最后几条日志不丢 —— 体积很小, 性能无虞。
-->
<nlog
  xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  internalLogLevel="Warn"
  internalLogFile="${basedir}/Logs/nlog-internal.log"
  throwConfigExceptions="false">

  <variable name="logDir" value="${basedir}/Logs" />

  <targets>
    <target
      xsi:type="File"
      name="file"
      fileName="${logDir}/IOStudio-${shortdate}.log"
      layout="${longdate} [${level:uppercase=true:padding=-5}] [${logger:shortName=true}] ${message}${when:when=length('${exception}')>0:inner= | ${exception:format=ToString}}"
      keepFileOpen="false"
      archiveEvery="Day"
      archiveAboveSize="8388608"
      maxArchiveFiles="20"
      archiveFileName="${logDir}/archive/IOStudio-${shortdate}.{#}.log" />
  </targets>

  <rules>
    <logger name="*" minlevel="Info" writeTo="file" />
  </rules>
</nlog>
