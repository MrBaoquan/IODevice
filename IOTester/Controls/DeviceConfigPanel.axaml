<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
             mc:Ignorable="d" d:DesignWidth="650" d:DesignHeight="500"
             x:Class="IOTester.Controls.DeviceConfigPanel">

    <UserControl.Styles>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1f2937"/>
        </Style>

        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#4b5563"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style Selector="TextBlock.field-desc">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#9ca3af"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="TextBlock.default-indicator">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#3b82f6"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.section-border">
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style Selector="Expander">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e5e7eb"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>

        <Style Selector="NumericUpDown">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <!-- 顶部工具栏：预设选择器和刷新/同步按钮 -->
        <Border Grid.Row="0" 
                BorderBrush="#e5e7eb" 
                BorderThickness="0,0,0,1" 
                Padding="0,0,0,12"
                Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                <!-- 预设选择器 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Name="PresetPanel" IsVisible="False">
                    <TextBlock Text="预设配置:" 
                              FontSize="13" 
                              Foreground="#4b5563" 
                              VerticalAlignment="Center"/>
                    <ComboBox Name="PresetComboBox"
                              Width="200"
                              Height="32"
                              FontSize="13"
                              ToolTip.Tip="选择预设配置快速填充参数"/>
                    <Button Name="ApplyPresetButton"
                            Content="应用"
                            Padding="12,6"
                            Background="#10b981"
                            Foreground="White"
                            FontSize="12"
                            IsEnabled="False"
                            ToolTip.Tip="应用选中的预设配置"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <!-- 重置按钮 -->
                    <Button Name="ResetButton"
                           Background="Transparent"
                           Padding="8"
                           ToolTip.Tip="重置为默认配置">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <iconPacks:PackIconIonicons Kind="RefreshCircleiOS" Width="16" Height="16" Foreground="#f59e0b"/>
                            <TextBlock Text="重置" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    
                    <Button Name="SaveAsPresetButton"
                           Background="Transparent"
                           Padding="8"
                           ToolTip.Tip="保存当前配置为预设">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <iconPacks:PackIconIonicons Kind="BookmarkiOS" Width="16" Height="16"/>
                            <TextBlock Text="存预设" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Name="OpenConfigFileButton"
                           Background="Transparent"
                           Padding="8"
                           ToolTip.Tip="使用外部编辑器编辑配置文件">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <iconPacks:PackIconIonicons Kind="CreateiOS" Width="16" Height="16"/>
                            <TextBlock Text="编辑" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="3"
                       Name="SyncSchemaButton"
                       Background="Transparent"
                       Padding="8"
                       Margin="4,0,0,0"
                       ToolTip.Tip="从INI同步配置项">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <iconPacks:PackIconIonicons Kind="SynciOS" Width="16" Height="16"/>
                        <TextBlock Text="同步" FontSize="12" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4"
                       Name="RefreshButton"
                       Background="Transparent"
                       Padding="8"
                       Margin="4,0,0,0"
                       ToolTip.Tip="刷新配置">
                    <iconPacks:PackIconIonicons Kind="RefreshiOS" Width="16" Height="16"/>
                </Button>
            </Grid>
        </Border>

        <!-- 配置内容区域 -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Name="ConfigContainer" Spacing="0">
                <!-- 动态生成的配置sections将添加到这里 -->

                <!-- 空状态提示 -->
                <Border Name="EmptyState"
                       BorderBrush="#e5e7eb" 
                       BorderThickness="1" 
                       CornerRadius="6" 
                       Padding="32"
                       Background="#f9fafb"
                       IsVisible="True">
                    <StackPanel Spacing="8" HorizontalAlignment="Center">
                        <iconPacks:PackIconIonicons Kind="SettingsiOS" 
                                                   Width="32" 
                                                   Height="32" 
                                                   Foreground="#9ca3af"
                                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="暂无设备配置" 
                                  Foreground="#9ca3af" 
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="选择External类型设备后将显示配置项" 
                                  Foreground="#d1d5db" 
                                  FontSize="12"
                                  HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
