<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
			 xmlns:vm="using:IOTester.ViewModels"
			 xmlns:iconPacks="https://github.com/MahApps/IconPacks.Avalonia"
			 xmlns:controls="using:IOTester.Controls"
             x:Class="IOTester.Controls.IODeviceView"
			 x:DataType="vm:Device">

	<Design.DataContext>
		<vm:Device />
	</Design.DataContext>

	<UserControl.Resources>
		<Thickness x:Key="ExpanderHeaderPadding">0</Thickness>
		<Thickness x:Key="ExpanderBorderThickness">0</Thickness>

		<Flyout x:Key="MySharedFlyout" Placement="Top" ShowMode="Transient">
			<TextBlock Text="Hello World" />
		</Flyout>
	</UserControl.Resources>


	<UserControl.Styles>
		<!-- IO 控制按钮样式 -->
		<Style Selector="Button.IOControl">
			<Setter Property="Background" Value="#e2e8f0"></Setter>
		</Style>

		<Style Selector="Button.IOControl:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#e2e8f0"></Setter>
		</Style>
		<Style Selector="Button.IOControl.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#059669"></Setter>
			<Setter Property="Foreground" Value="White"></Setter>
		</Style>


		<Style Selector="Button.IOControl.active">
			<Setter Property="Background" Value="#059669"></Setter>
			<Setter Property="Foreground" Value="White"></Setter>
		</Style>
		
		
		<!-- IO Key 按钮样式 -->
		<Style Selector="Button.DIButton">
			<Setter Property="Background" Value="#e2e8f0"></Setter>
		</Style>
		
		<Style Selector="Button.DIButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#e2e8f0"></Setter>
		</Style>
		<Style Selector="Button.DIButton.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#059669"></Setter>
			<Setter Property="Foreground" Value="White"></Setter>
		</Style>
		

		<Style Selector="Button.DIButton.active">
			<Setter Property="Background" Value="#059669"></Setter>
			<Setter Property="Foreground" Value="White"></Setter>
		</Style>
		
		<!-- img-btn 按钮 hover 样式 -->
		<Style Selector="Button.img-btn">
			<Setter Property="Background" Value="Transparent"/>
		</Style>
		
		<Style Selector="Button.img-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="#f3f4f6"/>
		</Style>

		<Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover">
			<Setter Property="Background" Value="LightBlue" />
		</Style>
		<Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
			<Setter Property="Background" Value="#e0f2fe" />
		</Style>

		<Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#ToggleButtonBackground:pointerover">
			<Setter Property="Background" Value="#e0f2fe" />
		</Style>

		<Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
			<Setter Property="BorderThickness" Value="0" />
		</Style>
		
	</UserControl.Styles>
	
	<DockPanel>
		<Border DockPanel.Dock="Top" BorderBrush="#e5e7eb" BorderThickness="0 0 0 0" Padding="0 0 0 0">
			<StackPanel>
				<Separator Background="#e2e8f0" HorizontalAlignment="Stretch" Margin="0 0 0 0" />
				<!-- 配置摘要区域 -->
				<Border Background="#f8fafc" 
						BorderBrush="#e2e8f0" 
						BorderThickness="0 0 0 1" 
						Padding="16 10"
						IsVisible="{Binding ConfigSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
						<StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
							<iconPacks:PackIconIonicons Kind="InformationCircleiOS" Width="14" Height="14" Foreground="#64748b" Margin="0 0 8 0" VerticalAlignment="Center"/>
							<TextBlock Text="配置摘要" FontSize="12" FontWeight="Medium" Foreground="#475569" Margin="0 0 16 0" VerticalAlignment="Center"/>
						</StackPanel>
						<TextBlock Grid.Column="1" 
								   Text="{Binding ConfigSummaryText}" 
								   Foreground="#64748b"
								   FontSize="12"
								   VerticalAlignment="Center"
								   TextTrimming="CharacterEllipsis"
								   ToolTip.Tip="{Binding ConfigSummaryText}"/>
						<Button Grid.Column="2" 
								Classes="img-btn" 
								ToolTip.Tip="设备配置" 
								Command="{Binding EditDevicePropertiesCommand}" 
								Width="24" Height="24" 
								Padding="0"
								Margin="12 0 0 0"
								VerticalAlignment="Center"
								HorizontalContentAlignment="Center"
								VerticalContentAlignment="Center">
							<iconPacks:PackIconIonicons Kind="SettingsiOS" Width="14" Height="14" Foreground="#64748b" VerticalAlignment="Center" HorizontalAlignment="Center"/>
						</Button>
					</Grid>
				</Border>
				<Grid ColumnDefinitions="24,*,24" Margin="0 8 0 0">
					<ToggleButton IsChecked="{Binding UserIOFullscreen}" Grid.Column="0" Width="24" Height="24" Padding="4" ToolTip.Tip="左侧全屏">
						<Image Source="avares://IOTester/Assets/fullscreen.png" />
					</ToggleButton>
					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Column="1">
						<!-- 设备配置按钮 -->
						<Button Classes="img-btn" ToolTip.Tip="设备配置" 
								Command="{Binding EditDevicePropertiesCommand}" 
								Width="24" Height="24" Padding="0"
								Margin="0 0 8 0">
							<iconPacks:PackIconIonicons Kind="SettingsiOS" Width="16" Height="16" Foreground="#64748b"/>
						</Button>
						<Button Classes="img-btn" ToolTip.Tip="修改配置文件" Command="{Binding EditConfigCommand}" 
								Width="24" Height="24" Padding="0"
								Margin="8 0" >
							<Image Source="avares://IOTester/Assets/edit-config.png" />
						</Button>
					</StackPanel>

					<ToggleButton IsChecked="{Binding StandardIOFullscreen}" Grid.Column="2" Width="24" Height="24" Padding="4" ToolTip.Tip="右侧全屏">
						<Image Source="avares://IOTester/Assets/fullscreen.png" />
					</ToggleButton>
				</Grid>
				<Separator Background="#e2e8f0" HorizontalAlignment="Stretch" Padding="0" Margin="0 8 0 0" />
			</StackPanel>
		</Border>
		
		<Grid>
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="{Binding CustomWidth}" />
				<ColumnDefinition Width="2" />
				<ColumnDefinition Width="{Binding StandardWidth}" />
			</Grid.ColumnDefinitions>
			<ScrollViewer Grid.Column="0" MinWidth="1">
			<StackPanel Margin="0 0 0 24">
				<!-- Action 输入 -->
				<StackPanel>
					<controls:CollapsibleHeader Title="Action 输入" 
												ItemCount="{Binding ActionList.Count}"
												ShowItemCount="True"
												IsExpanded="{Binding IsActionExpanded, Mode=TwoWay}"
												ShowEditButtons="{Binding IsEditMode}"
												AddCommand="{Binding AddActionCommand}"
												ClearCommand="{Binding ClearActionCommand}"
												AddTooltip="添加新的Action节点"
												ClearTooltip="清空所有Action节点" />
					<ItemsRepeater ItemsSource="{Binding ActionList}" IsVisible="{Binding IsActionExpanded}">
						<ItemsRepeater.Layout>
							<WrapLayout Orientation="Horizontal" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<controls:IONodeView MaxWidth="250" />
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</StackPanel>

				<!-- Axis 输入 -->
				<StackPanel Margin="0 12 0 0">
					<controls:CollapsibleHeader Title="Axis 输入" 
												ItemCount="{Binding AxisList.Count}"
												ShowItemCount="True"
												IsExpanded="{Binding IsAxisExpanded, Mode=TwoWay}"
												ShowEditButtons="{Binding IsEditMode}"
												AddCommand="{Binding AddAxisCommand}"
												ClearCommand="{Binding ClearAxisCommand}"
												AddTooltip="添加新的Axis节点"
												ClearTooltip="清空所有Axis节点" />
					<ItemsRepeater ItemsSource="{Binding AxisList}" IsVisible="{Binding IsAxisExpanded}">
						<ItemsRepeater.Layout>
							<WrapLayout Orientation="Horizontal" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<controls:IONodeView MaxWidth="250" />
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</StackPanel>
					
				<!-- OAction 输出 -->
				<StackPanel Margin="0 12 0 0">
					<controls:CollapsibleHeader Title="OAction 输出" 
												ItemCount="{Binding OActionList.Count}"
												ShowItemCount="True"
												IsExpanded="{Binding IsOActionExpanded, Mode=TwoWay}"
												ShowEditButtons="{Binding IsEditMode}"
												AddCommand="{Binding AddOActionCommand}"
												ClearCommand="{Binding ClearOActionCommand}"
												AddTooltip="添加新的OAction节点"
												ClearTooltip="清空所有OAction节点">
						<controls:CollapsibleHeader.ExtraContent>
							<Button Classes="img-btn" ToolTip.Tip="输出测试（模拟量/脉冲/跑马灯）" 
										Command="{Binding OpenOActionTestCommand}"
										Width="28" Height="28" Padding="0" Margin="8 0 0 0">
										<iconPacks:PackIconIonicons Kind="PulseiOS" Width="16" Height="16" Foreground="#64748b"/>
							</Button>
						</controls:CollapsibleHeader.ExtraContent>
					</controls:CollapsibleHeader>
					<ItemsRepeater ItemsSource="{Binding OActionList}" IsVisible="{Binding IsOActionExpanded}">
						<ItemsRepeater.Layout>
							<WrapLayout Orientation="Horizontal" />
						</ItemsRepeater.Layout>
						<ItemsRepeater.ItemTemplate>
							<DataTemplate>
								<controls:IONodeView MaxWidth="250" />
							</DataTemplate>
						</ItemsRepeater.ItemTemplate>
					</ItemsRepeater>
				</StackPanel>
			</StackPanel>
		</ScrollViewer>
		<GridSplitter Grid.Column="1" Background="WhiteSmoke" ResizeDirection="Columns" />
		<ScrollViewer Grid.Column="2" Margin="0" MinWidth="1">
				<StackPanel Orientation="Vertical" Margin="0 0 0 24">
					<!-- DI 输入 -->
					<StackPanel>
						<controls:CollapsibleHeader Title="DI 输入" 
													IsExpanded="{Binding DIExpand, Mode=TwoWay}">
							<controls:CollapsibleHeader.ExtraContent>
								<StackPanel Orientation="Horizontal">
									<ComboBox SelectedIndex="{Binding SelectedDICountIndex}"
											  Width="100"
											  MaxDropDownHeight="200" BorderThickness="1" BorderBrush="#e2e8f0">
										<ComboBoxItem>8 通道</ComboBoxItem>
										<ComboBoxItem>16 通道</ComboBoxItem>
										<ComboBoxItem>32 通道</ComboBoxItem>
										<ComboBoxItem>64 通道</ComboBoxItem>
										<ComboBoxItem>128 通道</ComboBoxItem>
										<ComboBoxItem>256 通道</ComboBoxItem>
									</ComboBox>
									<TextBlock Text="偏移" VerticalAlignment="Center" Margin="16 0 0 0" />
									<NumericUpDown Value="{Binding OffsetDIIndex}" BorderBrush="#e2e8f0"
												   Minimum="0" Maximum="{Binding OffsetDIMaxIndex}"
												   Width="100" Margin="8 0 0 0" FormatString="0" />
								</StackPanel>
							</controls:CollapsibleHeader.ExtraContent>
						</controls:CollapsibleHeader>
						<ItemsRepeater ItemsSource="{Binding DIKeys}" IsVisible="{Binding DIExpand}">
							<ItemsRepeater.Layout>
								<WrapLayout Orientation="Horizontal" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<Button Classes.active="{Binding Active}" Width="100" Height="32" Classes="DIButton" Margin="4">
										<TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Button>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</StackPanel>

					<!-- AD 输入 -->
					<StackPanel Margin="0 16 0 0">
						<controls:CollapsibleHeader Title="AD 输入" 
													IsExpanded="{Binding ADExpand, Mode=TwoWay}">
							<controls:CollapsibleHeader.ExtraContent>
								<StackPanel Orientation="Horizontal">
									<ComboBox SelectedIndex="{Binding SelectedADCountIndex}" 
											  Width="100"
											  MaxDropDownHeight="200" BorderThickness="1" BorderBrush="#e2e8f0">
										<ComboBoxItem>8 通道</ComboBoxItem>
										<ComboBoxItem>16 通道</ComboBoxItem>
										<ComboBoxItem>32 通道</ComboBoxItem>
										<ComboBoxItem>64 通道</ComboBoxItem>
										<ComboBoxItem>128 通道</ComboBoxItem>
										<ComboBoxItem>256 通道</ComboBoxItem>
									</ComboBox>
									<TextBlock Text="偏移" VerticalAlignment="Center" Margin="16 0 0 0" />
									<NumericUpDown Value="{Binding OffsetADIndex}" BorderBrush="#e2e8f0"
												   Minimum="0" Maximum="{Binding OffsetADMaxIndex}"
												   Width="100" Margin="8 0 0 0" FormatString="0" />
								</StackPanel>
							</controls:CollapsibleHeader.ExtraContent>
						</controls:CollapsibleHeader>
						<ItemsRepeater ItemsSource="{Binding ADKeys}" IsVisible="{Binding ADExpand}">
							<ItemsRepeater.Layout>
								<WrapLayout Orientation="Horizontal" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal" Margin="4">
										<TextBlock Width="70" HorizontalAlignment="Center" Text="{Binding Name}" VerticalAlignment="Center" Margin="8 0 0 0" />
										<Button Classes.active="{Binding Active}" Width="100" Height="32" Classes="DIButton" Margin="0" Command="{Binding ToggleDOCommand}">
											<TextBlock Text="{Binding Value, StringFormat='{}{0:F3}'}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
										</Button>
									</StackPanel>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</StackPanel>
					
					<!-- DO 输出 -->
					<StackPanel Margin="0 16 0 0">
						<controls:CollapsibleHeader Title="DO 输出" 
													IsExpanded="{Binding DOExpand, Mode=TwoWay}">
							<controls:CollapsibleHeader.ExtraContent>
								<StackPanel Orientation="Horizontal">
									<ComboBox SelectedIndex="{Binding SelectedDOCountIndex}" MaxDropDownHeight="200" 
											  BorderThickness="1" Width="100" BorderBrush="#e2e8f0">
										<ComboBoxItem>8 通道</ComboBoxItem>
										<ComboBoxItem>16 通道</ComboBoxItem>
										<ComboBoxItem>32 通道</ComboBoxItem>
										<ComboBoxItem>64 通道</ComboBoxItem>
										<ComboBoxItem>128 通道</ComboBoxItem>
										<ComboBoxItem>256 通道</ComboBoxItem>
									</ComboBox>
									<TextBlock Text="偏移" VerticalAlignment="Center" Margin="16 0 0 0" />
									<NumericUpDown Value="{Binding OffsetDOIndex}" BorderBrush="#e2e8f0"
												   Minimum="0" Maximum="{Binding OffsetDOMaxIndex}" 
												   Width="100" Margin="8 0 0 0" FormatString="0" />
									<Button Classes.active="{Binding AllOn}" Classes="IOControl"
											Margin="16 0 0 0"
											Width="60" Height="28" Command="{Binding ToggleAllDOCommand}">
										<TextBlock Text="{Binding ToggleAllDOText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Button>
									<Button Classes="img-btn" ToolTip.Tip="输出测试（模拟量/脉冲/跑马灯）" 
											Command="{Binding OpenDOTestCommand}"
											Width="28" Height="28" Padding="0" Margin="8 0 0 0">
										<iconPacks:PackIconIonicons Kind="PulseiOS" Width="16" Height="16" Foreground="#64748b"/>
									</Button>
								</StackPanel>
							</controls:CollapsibleHeader.ExtraContent>
						</controls:CollapsibleHeader>
						<ItemsRepeater ItemsSource="{Binding DOKeys}" x:Name="DORepeater" IsVisible="{Binding DOExpand}">
							<ItemsRepeater.Layout>
								<WrapLayout Orientation="Horizontal" />
							</ItemsRepeater.Layout>
							<ItemsRepeater.ItemTemplate>
								<DataTemplate>
									<Button Classes.active="{Binding Active}" Width="100" Height="32" Classes="DIButton" Margin="4" Command="{Binding ToggleDOCommand}">
										<TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
									</Button>
								</DataTemplate>
							</ItemsRepeater.ItemTemplate>
						</ItemsRepeater>
					</StackPanel>
				
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</DockPanel>
</UserControl>
