<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:vm="using:IOTester.ViewModels"
             x:Class="IOTester.Controls.TestControl"
			 x:DataType="vm:TestViewModel"
			 xmlns:controls="using:IOTester.Controls"
			 >
	<Design.DataContext>
		<vm:TestViewModel />
	</Design.DataContext>
	<ItemsRepeater ItemsSource="{Binding ActionList}">
		<ItemsRepeater.Layout>
			<WrapLayout Orientation="Horizontal" />
		</ItemsRepeater.Layout>
		<ItemsRepeater.ItemTemplate>
			<DataTemplate>
				<TextBlock Text="{Binding Name}" />
				<!--<controls:IONodeView MaxWidth="250" />-->
			</DataTemplate>
		</ItemsRepeater.ItemTemplate>
	</ItemsRepeater>
	
</UserControl>
