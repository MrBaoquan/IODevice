<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <Content Include="Sdk\iotoolkit.js" CopyToOutputDirectory="PreserveNewest" Link="Sdk\iotoolkit.js" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>IOToolkit.WebBridge</AssemblyName>
    <RootNamespace>IOToolkit.WebBridge</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\IODevice_CSharp_Wrapper\IODevice_CSharp_Wrapper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Sdk\iotoolkit.js" CopyToOutputDirectory="PreserveNewest" Link="Sdk\iotoolkit.js" />
  </ItemGroup>

  <PropertyGroup>
    <NativeOutputDir>$(MSBuildProjectDirectory)\..\Binaries\Win64\$(Configuration)\</NativeOutputDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(NativeOutputDir)IODevice.dll" Link="IODevice.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOutputDir)IODevice.dll')" />
    <None Include="$(NativeOutputDir)IODevice_C_Wrapper.dll" Link="IODevice_C_Wrapper.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOutputDir)IODevice_C_Wrapper.dll')" />
    <None Include="$(NativeOutputDir)ExternalLibraries\**\*" Link="ExternalLibraries\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOutputDir)ExternalLibraries')" />
    <None Include="$(NativeOutputDir)Config\**\*" Link="Config\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NativeOutputDir)Config')" />
  </ItemGroup>
</Project>


